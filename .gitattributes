# Защита от Windows CRLF: shell-скрипты и конфиги Hadoop ВСЕГДА LF.
# Иначе при клоне на Windows git подставляет CRLF, и контейнер падает с
# `/usr/bin/env: 'bash\r': No such file or directory`.

* text=auto eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.properties text eol=lf
.env*       text eol=lf
workers     text eol=lf
hadoop-env.sh text eol=lf
