# cluster.conf — Конфигурация Hadoop-кластера
#
# 1. Скопируйте в cluster.conf:     copy cluster.conf.example cluster.conf
# 2. Впишите реальные IP
# 3. Запустите:                      start.bat
#
# Формат:  IP_АДРЕС  роль1,роль2,...
#
# Роли:
#   namenode            — метаданные HDFS (ровно 1)
#   secondarynamenode   — чекпоинт NameNode
#   resourcemanager     — YARN (ровно 1)
#   historyserver       — история задач
#   datanode            — хранение данных + выполнение задач (мин. 1)

# === Впишите свои IP ===

192.168.1.10  namenode,secondarynamenode,resourcemanager,historyserver
192.168.1.11  datanode
192.168.1.12  datanode
