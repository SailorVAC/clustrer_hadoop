# Скопируй этот файл в .env на КАЖДОМ из 3 ноутбуков.
#
# IP-адреса должны быть теми, по которым ноуты ВИДЯТ ДРУГ ДРУГА в локальной
# сети. На Windows их можно посмотреть командой `ipconfig` (поле IPv4).

MASTER_IP=192.168.1.10
WORKER1_IP=192.168.1.11
WORKER2_IP=192.168.1.12

# Только для воркеров (docker-compose.worker.yml).
# На worker1-ноуте поставь worker1, на worker2-ноуте — worker2.
NODE_NAME=worker1

# Порты DataNode. Должны быть РАЗНЫМИ у разных воркеров (для обхода
# NAT-коллизии в NameNode'е). Формула: 9864/9866/9867 + (N-1)*10:
#   worker1 → 9864 / 9866 / 9867 (можно вообще не указывать — это дефолты)
#   worker2 → 9874 / 9876 / 9877
#   worker3 → 9884 / 9886 / 9887
#   ...
# На worker1-ноуте эти три строки можно оставить закомментированными.
# На worker2-ноуте — раскомментировать и оставить как есть.
#DN_HTTP_PORT=9874
#DN_XFER_PORT=9876
#DN_IPC_PORT=9877

# (Опционально) Версия Hadoop, которая будет скачана образом.
HADOOP_VERSION=3.3.6
